NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8080

# Compose overrides TEAMGG_API_BASE_URL with the internal backend service URL.
TEAMGG_API_BASE_URL=http://backend:7713
# Must exactly match the backend's value.
REPLAY_ANALYZER_SHARED_SECRET=replace-with-the-same-long-random-secret

MAX_UPLOAD_MB=250
MAX_CONCURRENT_ANALYSES=1
ANALYSIS_TIMEOUT=20m
KEEP_ARTIFACTS=false
LOL_EXECUTABLE_PATH=
LOL_DOWNLOAD_REGION=KR

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=6000
