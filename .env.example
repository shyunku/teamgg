# Optional Compose-only host port settings. Application secrets belong to each
# service's own .env.docker file.
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PUBLISHED_PORT=7713
ANALYZER_BIND_ADDRESS=0.0.0.0
ANALYZER_PUBLISHED_PORT=7720
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PUBLISHED_PORT=7730
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PUBLISHED_PORT=8080

# Override these only when using a non-default project environment file path.
BACKEND_ENV_FILE=./apps/backend/.env.docker
ANALYZER_ENV_FILE=./apps/lol-replay-analyzer/.env.docker
ADMIN_ENV_FILE=./apps/admin/.env.docker
