# Host-side retention scheduler. Copy to .env.retention on the Docker host.
# The example is inert. Both switches must be true before any action.
RETENTION_ENABLED=false
RETENTION_DELETE_ENABLED=false

# Cron should invoke the script hourly; the script limits runs to once per interval.
RETENTION_INTERVAL_DAYS=30
RETENTION_RETRY_HOURS=24
RETENTION_WINDOW_START=02:00
RETENTION_WINDOW_END=04:00
RETENTION_MATCH_PATCHES=8
RETENTION_BATCH_SIZE=100
RETENTION_BATCH_TIMEOUT=2m
RETENTION_WORK_LIMIT=10m

# Host disk path containing the MySQL data volume. Set explicitly for production.
RETENTION_DISK_PATH=/
RETENTION_MIN_FREE_GIB=12
RETENTION_MAX_THREADS_RUNNING=4
RETENTION_MAX_LOCK_WAITS=0
RETENTION_COMMAND_TIMEOUT_MINUTES=15

# Optional Slack-compatible incoming webhook. Keep the real URL private.
RETENTION_ALERT_WEBHOOK_URL=
