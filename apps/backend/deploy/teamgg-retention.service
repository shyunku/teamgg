[Unit]
Description=team.gg guarded match retention
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/home/ec2-user/workspace/teamgg/.env.retention

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/workspace/teamgg
ExecStart=/usr/bin/python3 /home/ec2-user/workspace/teamgg/apps/backend/scripts/retention_scheduler.py
ExecStopPost=/usr/bin/python3 /home/ec2-user/workspace/teamgg/apps/backend/scripts/retention_scheduler.py --restore-backend
TimeoutStartSec=20min
TimeoutStopSec=3min
