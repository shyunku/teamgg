APP_SERVER_PORT=7713

# main configs
IS_PROD=false               # whether the server is running in production
DEBUG=true                  # if true, activate debug & test logics
DEBUG_ON_PRODUCTION=false   # debugging on production mode
URGENT=false                # if true, ignore less-secure errors

# Database
DB_USER=teamgg
DB_PASSWORD=replace-me
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=teamgg

# Database migrations (safe default: validate only)
DB_MIGRATION_MODE=validate
DB_MIGRATION_LOCK_TIMEOUT=30s
DB_MIGRATION_SUMMONER_MATCH_BATCH=1000

# Redis
REDIS_ADDR=host.docker.internal:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRE=1h
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRE=720h

# Riot API
RIOT_API_KEY=
RIOT_API_SHORT_WINDOW_LIMIT=12
RIOT_API_LONG_WINDOW_LIMIT=1200
RIOT_API_MAX_CONCURRENCY=8

# Riot Auth
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
RSO_CLIENT_CALLBACK_URI=http://localhost:7713/v1/auth/rsoLogin

# Replay Analyzer Server Config
## This is returned to the browser. Use the public HTTPS analyzer URL in production.
REPLAY_ANALYZER_BASE_URL=http://localhost:7720
## Must exactly match the analyzer's value.
REPLAY_ANALYZER_SHARED_SECRET=replace-with-the-same-long-random-secret
REPLAY_ANALYSIS_STALE_AFTER=45m

# DataExplorer
DATA_EXPLORER_ENABLED=false
DATA_EXPLORER_BOOTSTRAP_ENABLED=false
DATA_EXPLORER_PARTICIPANT_DISCOVERY=disabled
DATA_EXPLORER_MAX_DEPTH=0
DATA_EXPLORER_DEBUG=false

DATA_EXPLORER_SUMMONER_WORKERS=1
DATA_EXPLORER_MATCH_WORKERS=2
DATA_EXPLORER_DAILY_SUMMONER_BUDGET=500
DATA_EXPLORER_DAILY_MATCH_BUDGET=1500
DATA_EXPLORER_MATCH_COUNT=3

DATA_EXPLORER_SUMMONER_REVISIT_INTERVAL=720h  # prevent revisiting same summoner on data explorer
DATA_EXPLORER_MATCH_REVISIT_INTERVAL=8760h    # prevent revisiting same match on data explorer
DATA_EXPLORER_CLEANUP_ENABLED=false           # whether to clean up data explorer jobs (process state) on debug
DATA_EXPLORER_CLEANUP_INTERVAL=30s
DATA_EXPLORER_CLEANUP_BATCH_SIZE=500
DATA_EXPLORER_COMPLETED_JOB_RETENTION=24h     # data explorer job expire time
DATA_EXPLORER_SOURCE_RETENTION=24h            # data explorer match_sources expire time

DATA_EXPLORER_METRICS_ENABLED=true
DATA_EXPLORER_METRICS_INTERVAL=5m

DATA_EXPLORER_ALERT_BUDGET_PERCENT=80
DATA_EXPLORER_ALERT_SUMMONER_QUEUE=10000
DATA_EXPLORER_ALERT_MATCH_QUEUE=10000
DATA_EXPLORER_ALERT_FAILED_JOBS=100
# Set this to the threshold for approximately 80% of the DB volume. Supports bytes or K/KB/M/MB/G/GB/T/TB (1024-based). 0 disables it.
DATA_EXPLORER_ALERT_DATABASE_BYTES=0
DATA_EXPLORER_ALERT_DAILY_ROW_GROWTH=1000000
DATA_EXPLORER_ALERT_TEMP_DISK_PERCENT=25


# Statistics
STATISTICS_RETRY_DELAY=5m
STATISTICS_LOCK_TIMEOUT=1s
STATISTICS_LOCK_RETRY_DELAY=15s

STATISTICS_TIER_ENABLED=false
STATISTICS_TIER_PERIOD=12h
STATISTICS_TIER_INITIAL_DELAY=30s

STATISTICS_MASTERY_ENABLED=false
STATISTICS_MASTERY_PERIOD=12h
STATISTICS_MASTERY_INITIAL_DELAY=2m

STATISTICS_CHAMPION_DETAIL_ENABLED=false
STATISTICS_CHAMPION_DETAIL_PERIOD=24h
STATISTICS_CHAMPION_DETAIL_INITIAL_DELAY=10m
