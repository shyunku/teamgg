HOST=0.0.0.0
PORT=7730

# Docker Compose overrides both service URLs with internal DNS names.
TEAMGG_API_BASE_URL=http://backend:7713
REPLAY_ANALYZER_BASE_URL=http://replay-analyzer:7720

# Must exactly match ADMIN_INTERNAL_SECRET in apps/backend/.env.
ADMIN_INTERNAL_SECRET=replace-with-a-long-random-secret
ADMIN_ALLOWED_ORIGINS=http://localhost:8080,https://teamgg.kr,https://www.teamgg.kr
ADMIN_REQUEST_TIMEOUT=5s
ADMIN_SHUTDOWN_TIMEOUT=10s
