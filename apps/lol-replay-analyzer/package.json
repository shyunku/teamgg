{
  "name": "teamgg-lol-replay-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "ROFL replay decoding and AI match analysis server for team.gg",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/index.test.ts",
    "analyze:rofl": "tsx src/cli.ts",
    "generate:secret": "node scripts/generate-secret.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.2.1",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "lol-exe-downloader": "^0.3.1",
    "openai": "^6.49.0",
    "rofl-parser": "0.4.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
