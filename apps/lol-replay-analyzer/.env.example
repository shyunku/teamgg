NODE_ENV=development
HOST=0.0.0.0
PORT=7720
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8080

# team.gg shared custom-game analysis integration
TEAMGG_API_BASE_URL=http://localhost:7713
REPLAY_ANALYZER_SHARED_SECRET=replace-with-the-same-long-random-secret-as-teamgg-backend

# Upload and decoder limits
MAX_UPLOAD_MB=250
MAX_CONCURRENT_ANALYSES=1
ANALYSIS_TIMEOUT=20m
WORK_DIR=./.work
ROFL_CACHE_DIR=./.rofl-cache
KEEP_ARTIFACTS=false

# Leave empty to let rofl-parser download the exact matching executable.
# Set this only when every uploaded replay matches the local executable build.
LOL_EXECUTABLE_PATH=
LOL_DOWNLOAD_REGION=KR

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Optional: none, low, medium, high, xhigh, max. Empty uses the model default.
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=6000
