NODE_ENV=development
HOST=0.0.0.0
PORT=7720
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8080

# team.gg shared custom-game analysis integration
# Compose overrides this with the internal backend service URL.
TEAMGG_API_BASE_URL=http://backend:7713
# Must exactly match REPLAY_ANALYZER_SHARED_SECRET in the backend environment.
REPLAY_ANALYZER_SHARED_SECRET=replace-with-the-same-long-random-secret

# Upload and decoder limits
MAX_UPLOAD_MB=250
MAX_CONCURRENT_ANALYSES=1
ANALYSIS_TIMEOUT=20m
# Compose mounts persistent volumes at these paths and overrides both values.
WORK_DIR=/app/.work
ROFL_CACHE_DIR=/app/.rofl-cache
KEEP_ARTIFACTS=false

# Leave empty to let rofl-parser download the exact matching executable.
# Set this only when every uploaded replay matches the configured executable build.
LOL_EXECUTABLE_PATH=
LOL_DOWNLOAD_REGION=KR

# AI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Optional: none, low, medium, high, xhigh, max. Empty uses the model default.
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=6000
