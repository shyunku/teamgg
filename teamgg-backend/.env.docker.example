APP_SERVER_PORT=7713

DB_USER=teamgg
DB_PASSWORD=replace-me
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=teamgg

REDIS_ADDR=host.docker.internal:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRE=1h
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRE=720h

RIOT_API_KEY=
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
RSO_CLIENT_CALLBACK_URI=http://localhost:7713/v1/auth/rsoLogin

DEBUG=true
IS_PROD=false
DEBUG_ON_PRODUCTION=false
URGENT=false

# This is returned to the browser. Use the public HTTPS analyzer URL in production.
REPLAY_ANALYZER_BASE_URL=http://localhost:7720
# Must exactly match the analyzer's value.
REPLAY_ANALYZER_SHARED_SECRET=replace-with-the-same-long-random-secret
REPLAY_ANALYSIS_STALE_AFTER=45m

RIOT_API_SHORT_WINDOW_LIMIT=12
RIOT_API_LONG_WINDOW_LIMIT=1200
RIOT_API_MAX_CONCURRENCY=8

DATA_EXPLORER_ENABLED=false
DATA_EXPLORER_SUMMONER_WORKERS=1
DATA_EXPLORER_MATCH_WORKERS=2
DATA_EXPLORER_DAILY_SUMMONER_BUDGET=10000
DATA_EXPLORER_DAILY_MATCH_BUDGET=30000
DATA_EXPLORER_MATCH_COUNT=3
DATA_EXPLORER_DEBUG=false

STATISTICS_TIER_ENABLED=false
STATISTICS_TIER_PERIOD=12h
STATISTICS_TIER_INITIAL_DELAY=30s
STATISTICS_MASTERY_ENABLED=false
STATISTICS_MASTERY_PERIOD=12h
STATISTICS_MASTERY_INITIAL_DELAY=2m
STATISTICS_CHAMPION_DETAIL_ENABLED=false
STATISTICS_CHAMPION_DETAIL_PERIOD=24h
STATISTICS_CHAMPION_DETAIL_INITIAL_DELAY=10m
STATISTICS_RETRY_DELAY=5m
STATISTICS_LOCK_RETRY_DELAY=15s
STATISTICS_LOCK_TIMEOUT=1s
